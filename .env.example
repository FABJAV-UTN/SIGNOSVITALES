# Copiá este archivo como .env (en esta misma carpeta) y completá los valores:
#   cp .env.example .env
# El archivo .env NO se sube al repositorio (está en el .gitignore).

# Contraseñas de los usuarios del sistema (obligatorias, mínimo 6 caracteres).
SISVAP_ADMIN_PASSWORD=cambiar-esta-clave
SISVAP_VOLUNTARIO_PASSWORD=cambiar-esta-otra-clave

# Clave para firmar las sesiones (JWT). Generá una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejás vacía, se genera una distinta en cada arranque y
# todos tienen que volver a iniciar sesión cuando se reinicia el backend.
SISVAP_SECRET_KEY=
